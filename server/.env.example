# Server Configuration
# The port the Node.js backend will run on
PORT=5000

# The environment mode (development or production)
NODE_ENV=development

# MongoDB Connection String
# Must be a valid MongoDB URI. In Docker Compose, this is often set to 'mongodb://mongo:27017/careerminds'
MONGO_URI=your_mongodb_connection_string

# JWT Secret for authenticating users
# Keep this string secure and random in production
JWT_SECRET=your_jwt_secret_key

# JWT Expiration Time (e.g., 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# Google Gemini API Key
# Used by Vercel AI SDK (@ai-sdk/google)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key

# Email Configuration for OTP/Password Reset
# The email address used to send out system emails
EMAIL_USER=your_email@gmail.com
# An app password or secure password for the email account
EMAIL_PASS=your_gmail_app_password

# Client URL / Allowed Origins
# The URL where your React frontend is hosted. Used to configure CORS.
ALLOWED_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:3000
